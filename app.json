{
  "expo": {
    "name": "Точка Роста",
    "slug": "tochka-rosta-app",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "tochkarostaapp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#061009",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.tochkarosta.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#061009",
        "foregroundImage": "./assets/brand/app-icon.png"
      },
      "package": "ru.tochkarosta.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#061009",
          "image": "./assets/brand/logo-mark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#061009",
            "image": "./assets/brand/logo-mark.png"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Разрешите «Точке Роста» сканировать QR-коды и штрихкоды продуктов.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите «Точке Роста» выбирать фотографии профиля и продуктов.",
          "cameraPermission": "Разрешите «Точке Роста» фотографировать профиль и продукты.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
